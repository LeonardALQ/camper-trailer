---
// One build step (STEP-01 to STEP-08), from data/steps.yaml through steps_data.json.
import steps from '../data/generated/steps_data.json';
import bom from '../data/generated/bom.json';
import reg from '../data/generated/register.json';
import CadViewer from './CadViewer.astro';
import { withBase } from '../lib/url';

interface Props {
  id: string;
}
const { id } = Astro.props;
const s = steps.steps.find((x: any) => x.id === id)!;
const lines = Object.fromEntries(bom.lines.map((l: any) => [l.id, l]));
const bikes = Object.fromEntries(bom.bikes.map((b: any) => [b.part, b]));
const revision = Object.fromEntries(reg.drawings.map((d: any) => [d.number, d.revision]));
---

<p>{s.action}</p>
<p>{s.why}</p>

<CadViewer step={s.id} height={460} />
<p class="muted">New parts in this step are shown in their own colours. Earlier work is grey.</p>

<h2>Parts used</h2>
{s.parts.length === 0 && <p>No parts from the bill of materials. Use cheap mock-up material.</p>}
{s.parts.length > 0 && (
  <div class="data-table">
    <table>
      <thead><tr><th>ID</th><th>Item</th><th>Product</th><th>Used in this step</th><th class="num">Line kg</th></tr></thead>
      <tbody>
        {s.parts.map((p: any) => {
          const l = lines[p.part] ?? bikes[p.part];
          return (
            <tr>
              <td>{p.part}</td><td>{l?.item}</td><td>{l?.product ?? ''}</td><td>{p.qty}</td>
              <td class="num">{l ? l.mass_kg.toFixed(2) : ''}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
)}

<dl class="step-meta">
  <dt>Tools</dt>
  <dd>{s.tools.join(', ')}</dd>
  {s.consumables.length > 0 && (<><dt>Consumables</dt><dd>{s.consumables.join(', ')}</dd></>)}
  {s.drawings.length > 0 && (
    <><dt>Drawings</dt><dd>{s.drawings.map((d: string, i: number) => (<>{i > 0 && ', '}<a href={withBase(`/drawings/#${d.toLowerCase()}`)}>{d} rev {revision[d] ?? 'A'} (draft)</a></>))}</dd></>
  )}
</dl>

<h2>Do this</h2>
<ol>
  {s.instructions.map((t: string) => <li>{t}</li>)}
</ol>

<h2>Check before you go on</h2>
<ul>
  {s.checks.map((t: string) => <li>[ ] {t}</li>)}
</ul>

{s.hold_points.length > 0 && (
  <>
    <h2>Hold point</h2>
    {s.hold_points.map((t: string) => <p class="hold">{t}</p>)}
  </>
)}
{s.attention.length > 0 && (
  <>
    <h2>Watch out</h2>
    {s.attention.map((t: string) => <p class="attention">(i) {t}</p>)}
  </>
)}
