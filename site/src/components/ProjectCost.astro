---
// The whole project's cost on the home page: the truck, its upgrades, the bike box and the trailer, each with its
// figure before contingency, its contingency, its total and its parts list. cad/sitedata.py (project_costs) writes
// project.json from data/project.yaml and the parts lists, so the table follows the data. A part without prices
// shows "pending" and the total leaves it out. The table has its own Total row, so it is a plain table with no sheet
// footer to repeat it (data-sheet="off").
import p from '../data/generated/project.json';
import { withBase } from '../lib/url';

const d: any = p;
const aud = (v: number) => Math.round(v).toLocaleString('en-AU');
const box = d.rows.find((r: any) => r.id === 'box');
const trailer = d.rows.find((r: any) => r.id === 'trailer' && !r.pending);
const left = d.pending.length ? `, without the ${d.pending.join(' and ').toLowerCase()}` : '';
const tpct = trailer?.contingency_pct;
const car = d.car;
const list = (a: string[]) => (a.length < 3 ? a.join(' and ') : `${a.slice(0, -1).join(', ')} and ${a[a.length - 1]}`);
const closes = car.gap > 0 && car.closing.length
  ? `, and ${list(car.closing)} ${car.closing.length > 1 ? 'bring' : 'brings'} it to AUD ${aud(car.with_closing)} if ${car.closing.length > 1 ? 'each one\'s' : 'its'} condition holds` : '';
const note = [
  "The truck is a near-new listing with NSW duty (research report 31).",
  `The truck's upgrades are their build list with an allowance of ${car.allowance_pct.listing} % on listed prices and ${car.allowance_pct.estimate} % on estimates, AUD ${aud(Math.abs(car.gap))} ${car.gap > 0 ? 'over' : 'under'} Leonard's AUD ${aud(car.budget)} for them${closes}. Their check list, AUD ${aud(car.check)} if every line were bought, and their optional extras are not counted.`,
  box ? `The bike box is every line of its parts list with ${box.contingency_pct} % contingency. Leonard builds it, so no labour is paid.` : '',
  trailer && tpct ? `The trailer is every line of its parts list with ${tpct.listing} % contingency on listed prices and ${tpct.estimate} % on rates and estimates. Leonard builds it, so no labour is hired.` : '',
  d.pending.length ? `The ${d.pending.join(' and ').toLowerCase()} has no prices yet.` : '',
  "Leonard's own labour is outside every figure. Each figure is rounded to the dollar, so a row can differ from its parts by AUD 1.",
].filter(Boolean).join(' ');
---

<div class="data-table project-cost" data-sheet="off">
  <table>
    <thead>
      <tr>
        <th>Part</th><th class="num">Before contingency AUD</th><th class="num">Contingency AUD</th><th class="num">Total AUD</th>
        <th>Parts list</th>
      </tr>
    </thead>
    <tbody>
      {d.rows.map((r: any) => (
        <tr>
          <td>{r.part}</td>
          {r.pending ? (
            <>
              <td class="num">pending</td><td class="num">pending</td><td class="num">pending</td>
            </>
          ) : (
            <>
              <td class="num">{aud(r.before)}</td>
              <td class="num">{aud(r.contingency)}</td>
              <td class="num">{aud(r.total)}</td>
            </>
          )}
          <td><a href={withBase(r.link)}>{r.link_text}</a></td>
        </tr>
      ))}
      <tr class="row-total">
        <td>{d.pending.length ? `Total so far${left}` : 'Total'}</td>
        <td class="num">{aud(d.before)}</td>
        <td class="num">{aud(d.contingency)}</td>
        <td class="num">{aud(d.total)}</td>
        <td></td>
      </tr>
    </tbody>
  </table>
</div>

<p>{note}</p>

<style>
  .project-cost td:first-child {
    white-space: nowrap;
  }
</style>
