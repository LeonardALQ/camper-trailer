---
// Whole-trailer tables, from build/trailer/trailer.json (cad/trailer.py).
import t from '../data/generated/trailer.json';
import cj from '../data/generated/chassis.json';
import { withBase } from '../lib/url';

interface Props {
  kind: 'summary' | 'cases' | 'checks' | 'chassis' | 'crossmembers' | 'groups' | 'uncertain' | 'schedule';
}
const { kind } = Astro.props;
const r: any = t;
const n = (v: number | null | undefined, d = 0) =>
  v == null ? '' : (Math.abs(v) < 0.5 * 10 ** -d ? 0 : v).toLocaleString('en-AU', { minimumFractionDigits: d, maximumFractionDigits: d });
const signed = (v: number) => (v > 0 ? '+' : '') + n(v);
const ch = r.chassis;
const P = r.params;
const raiser = (cj as any).members.find((m: any) => m.role === 'raiser');
const CP = (cj as any).params;
const plate = r.caps.plated;
const tv = r.tow_vehicle;
const tc = (id: string) => r.cases.find((c: any) => c.id === id);
const full = tc('TC2');
const chk = (id: string) => r.checks.find((c: any) => c.id === id);
const heaviest = r.cases.reduce((a: any, c: any) => (c.growth.mass_kg > a.growth.mass_kg ? c : a));
const fails = r.checks.filter((c: any) => c.severity === 'fail' && !c.ok);
const rowClass = (c: any) => (c.ok ? '' : c.severity === 'fail' ? 'row-fail' : 'row-report');
const statusClass = (c: any) => (c.ok ? 'status-pass' : c.severity === 'fail' ? 'status-fail' : 'status-report');
const measured = (c: any) => {
  if (c.measured == null) return '';
  const v = Math.abs(c.measured);
  const d = c.unit === '%' ? 1 : c.unit === '' || c.unit === 'deg' || v < 1 ? 3 : v < 10 ? 2 : v < 1000 ? 1 : 0;
  return `${n(c.measured, d)} ${c.unit}`.trim();
};
const groupRows = Object.entries(r.tare_by_group) as [string, any][];
const tareGroups = groupRows.reduce((s, [, g]) => s + g.mass_kg, 0);
// whole kg by largest remainder, so the rows add up to the rounded total (F3-09)
const lr = (vals: number[]) => {
  const out = vals.map((v) => Math.floor(v));
  let rem = Math.round(vals.reduce((a, b) => a + b, 0)) - out.reduce((a, b) => a + b, 0);
  vals.map((v, i) => [v - Math.floor(v), i] as [number, number]).sort((a, b) => b[0] - a[0])
    .forEach(([, i]) => { if (rem > 0) { out[i] += 1; rem -= 1; } });
  return out;
};
const gMass = lr(groupRows.map(([, g]) => g.mass_kg));
const gGrowth = lr(groupRows.map(([, g]) => g.growth_kg));
---

{kind === 'summary' && (
  <p>
    The body is {n(r.body_length)} mm long and {n(P.body_width)} mm wide, with a lift bed across the front over the desk, a wet room
    across the rear and a fixed roof. The
    tow vehicle is the {tv.name}. With the axle group centre {n(P.axle_x)} mm behind the ball, the trailer carries{' '}
    {n(full.nominal.towball_kg)} kg on the ball fully loaded, {n(full.nominal.towball_pct, 1)} % of its {n(full.nominal.mass_kg)} kg.
    Its tare is {n(r.tare_kg)} kg, or {n(tc('TC1').growth.mass_kg)} kg with the growth allowance. The heaviest case with growth,{' '}
    {heaviest.id}, is {n(heaviest.growth.mass_kg)} kg against the {n(plate)} kg plated ATM, with {n(heaviest.growth.towball_kg)} kg
    on the ball against the towbar's {n(tv.limits.towball_rating_kg)} kg. At the heaviest towball the ute's rear axle carries{' '}
    {n(chk('MAS-03').measured)} kg of its {n(tv.limits.rear_axle_kg)} kg plate (MAS-03). The combination is {n(chk('GCM-01').measured)} kg against the
    ute's {n(tv.limits.gcm_kg)} kg GCM. No ballast is needed. {fails.length === 0
      ? 'Every whole-trailer check passes.'
      : `${fails.length} whole-trailer checks fail: ${fails.map((c: any) => `${c.id} (${c.title.toLowerCase()}, ${measured(c)})`).join(', ')}.`}
  </p>
)}

{kind === 'cases' && (
  <div class="data-table">
    <table data-sheet-sum="off">
      <thead>
        <tr><th>Case</th><th>What is aboard</th><th class="num">Mass kg</th><th class="num">CoG X</th><th class="num">CoG Z</th>
          <th class="num">Towball kg</th><th class="num">Towball %</th><th class="num">Axle group kg</th>
          <th class="num">Plate margin kg</th><th class="num">GTM margin kg</th>
          <th class="num">With growth kg</th><th class="num">Towball kg</th><th class="num">Plate margin kg</th></tr>
      </thead>
      <tbody>
        {r.cases.map((c: any) => (
          <tr>
            <td>{c.id}</td><td>{c.name}. {c.aboard}{c.water_l ? ` (${n(c.water_l)} L)` : ''}</td>
            <td class="num">{n(c.nominal.mass_kg)}</td><td class="num">{n(c.nominal.cog[0])}</td><td class="num">{n(c.nominal.cog[2])}</td>
            <td class="num">{n(c.nominal.towball_kg)}</td><td class="num">{n(c.nominal.towball_pct, 1)}</td>
            <td class="num">{n(c.nominal.axle_kg)}</td>
            <td class={`num ${plate - c.nominal.mass_kg < 0 ? 'status-fail' : ''}`}>{signed(plate - c.nominal.mass_kg)}</td>
            <td class={`num ${r.supplier.kit_gtm - c.nominal.axle_kg < 0 ? 'status-fail' : ''}`}>{signed(r.supplier.kit_gtm - c.nominal.axle_kg)}</td>
            <td class="num">{n(c.growth.mass_kg)}</td><td class="num">{n(c.growth.towball_kg)}</td>
            <td class={`num ${plate - c.growth.mass_kg < 0 ? 'status-fail' : ''}`}>{signed(plate - c.growth.mass_kg)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}

{kind === 'checks' && (
  <div class="data-table">
    <table data-sheet-sum="off">
      <thead><tr><th>ID</th><th>Check</th><th>Limit</th><th>Measured</th><th>Result</th><th>Detail</th><th>Inputs</th></tr></thead>
      <tbody>
        {r.checks.map((c: any) => (
          <tr class={rowClass(c)}>
            <td>{c.id}</td><td>{c.title}</td><td>{c.limit}</td><td>{measured(c)}</td>
            <td class={statusClass(c)}>{c.status}{c.severity === 'report' ? ' (reported only)' : ''}</td><td>{c.detail}</td>
            <td>{(c.inputs ?? []).map((i: string, k: number) => (<>{k ? ', ' : ''}<a href={withBase(`/measurements/#${i.toLowerCase()}`)}>{i}</a></>))}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}

{kind === 'chassis' && (
  <div class="data-table">
    <table data-sheet-sum="off">
      <thead><tr><th>Input</th><th class="num">Value</th><th>Basis</th></tr></thead>
      <tbody>
        <tr><td>Rail outer width at the XT hinges</td><td class="num">{n(ch.rail_outer_width)} mm</td><td>With C/F {n(ch.cf)} (SUP-04) and ET {n(ch.wheel_offset)} it gives a {n(ch.track)} mm track, effective C/F {n(ch.cf - ch.wheel_offset)} mm against Cruisemaster's 200 mm limit. Cruisemaster's minimum is 1,150 mm</td></tr>
        <tr><td>Wheels and tyres</td><td class="num">{n(ch.tyre_d)} mm</td><td>{r.wheel.name} with {r.wheel.tyre}, on {r.wheel.hub}. {r.wheel.src}</td></tr>
        <tr><td>Rail inside width and centres</td><td class="num">{n(ch.rail_inner_width)} / {n(ch.rail_centres)} mm</td><td>{n(P.rail_w)} mm wide rails</td></tr>
        <tr><td>Main rails</td><td class="num">{n(ch.rail_length)} mm</td><td>X {n(ch.rail_x0)} to {n(ch.rail_x1)}, the full body length. Section {ch.rail_section}</td></tr>
        <tr><td>Rail underside and top</td><td class="num">Z {n(ch.rail_underside_z)} / {n(ch.rail_top_z)}</td><td>Hub {n(P.hub_below_rail)} mm below the rail underside at rated load (Cruisemaster), static loaded radius {n(ch.hub_z)} mm (est.)</td></tr>
        <tr><td>Raiser height</td><td class="num">{n(ch.raiser_h)} mm</td><td>Rail top to the floor underside at Z {n(ch.floor_underside_z)}: an {raiser.section} raiser and a {n(CP.strip_t, 1)} mm bearer strip. The floor clears the tyre at full bump by {n(ch.tyre_floor_clearance)} mm</td></tr>
        <tr><td>Floor surface</td><td class="num">Z {n(ch.floor_z)}</td><td>Floor underside plus the {n(P.floor_t)} mm floor panel</td></tr>
        <tr><td>Drawbar, ball to body front</td><td class="num">{n(ch.drawbar_length)} mm</td><td>At a 90 degree jack-knife the nearest part, the {ch.jackknife_governing.split(',')[0].toLowerCase()}, stands {n(ch.jackknife_mm)} mm clear of the sweep of the ute's bike box (radius {n(ch.sweep.radius_mm, 1)} mm, JK-01)</td></tr>
        <tr><td>Drawbar box</td><td class="num">X {n(ch.drawbar_box[0])} to {n(ch.drawbar_box[3])}</td><td>{n(P.dbx_w)} mm wide and {n(P.dbx_h)} mm high on the drawbar members, holding the two generators and the fuel cans (DX-01)</td></tr>
        <tr><td>Spare wheel</td><td class="num">X {n(ch.spare_box[0])} to {n(ch.spare_box[3])}</td><td>On the body's front wall above the drawbar, centred on Y, its centre at Z {n((ch.spare_box[2] + ch.spare_box[5]) / 2)}</td></tr>
        <tr><td>Drawbar members</td><td class="num">{n(ch.drawbar_member_length)} mm</td><td>Each, from the coupling head to the body front, then {n(ch.drawbar_tail)} mm on under the rails</td></tr>
        <tr><td>Coupling point and drop</td><td class="num">Z {n(ch.coupling_z)}</td><td>The ute's laden ball height (UTE-01), {n(ch.drop_rail_to_coupling)} mm below the rail underside, with the DO35 under the coupling head</td></tr>
        <tr><td>Axle group centre</td><td class="num">X {n(ch.axle_x)}</td><td>Hubs at X {n(ch.hubs_x[0])} and {n(ch.hubs_x[1])}, {n(ch.axle_spacing)} mm apart. XT front hinge crossmember rear face X {n(ch.xt_front_hinge_rear_x)}, rear shock crossmember front face X {n(ch.xt_rear_shock_front_x)}</td></tr>
        <tr><td>Overall length</td><td class="num">{n(ch.overall_length)} mm</td><td>Coupling head front (X {n(ch.overall_x0)}) to the body rear</td></tr>
        <tr><td>Overall width</td><td class="num">{n(ch.overall_width)} mm</td><td>{n(P.body_width)} mm body and what stands proud of its sides, the awning on the roof inside it (DIM-01)</td></tr>
        <tr><td>Travel height</td><td class="num">{n(ch.travel_height)} mm</td><td>Top of the solar panels on the fixed roof</td></tr>
        <tr><td>CoG, fully loaded</td><td class="num">X {n(ch.cog_loaded[0])}, Z {n(ch.cog_loaded[2])}</td><td>Z {n(ch.cog_loaded_growth[2])} with growth. {n(ch.cog_height_above_hub)} mm above the hub centres, for the roll and track check</td></tr>
        <tr><td>Water tanks</td><td class="num">{n(ch.tank_capacity_l)} L</td><td>Gross volume of the two fresh tanks between the rails in the suspension bays</td></tr>
      </tbody>
    </table>
  </div>
)}

{kind === 'crossmembers' && (
  <div class="data-table">
    <table data-sheet-sum="off">
      <thead><tr><th>Crossmember</th><th class="num">X front face</th><th>Under</th><th>Section</th></tr></thead>
      <tbody>
        {ch.crossmembers.map((x: any) => (
          <tr><td>{x.station}</td><td class="num">{n(x.x_front)}</td><td>{x.under}</td><td>{x.section}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
)}

{kind === 'groups' && (
  <div class="data-table">
    <table data-sheet-sum="sum">
      <thead><tr><th>Group</th><th class="num">Tare kg</th><th class="num">With growth kg</th></tr></thead>
      <tbody>
        {groupRows.map(([g], i) => (<tr><td>{g}</td><td class="num">{n(gMass[i])}</td><td class="num">{n(gGrowth[i])}</td></tr>))}
        <tr class="row-total"><td>Tare</td><td class="num">{n(gMass.reduce((a, b) => a + b, 0))}</td><td class="num">{n(gGrowth.reduce((a, b) => a + b, 0))}</td></tr>
      </tbody>
    </table>
  </div>
)}

{kind === 'uncertain' && (
  <div class="data-table">
    <table>
      <thead><tr><th>Line</th><th class="num" data-sheet-mass>Mass kg</th><th class="num">Growth allowance kg</th><th class="num" data-sheet-sum="cog">CoG X</th><th class="num">Towball change for +20 %</th></tr></thead>
      <tbody>
        {r.least_certain.map((u: any) => (
          <tr><td>{u.id} {u.name}{u.count > 1 ? ` (${u.count})` : ''}</td><td class="num">{n(u.mass_kg)}</td><td class="num">{n(u.growth_kg)}</td>
            <td class="num">{n(u.cog_x)}</td><td class="num">{signed(Math.round(u.towball_per_20pct_kg * 10) / 10)} kg</td></tr>
        ))}
      </tbody>
    </table>
  </div>
)}

{kind === 'schedule' && (
  <div class="data-table">
    <table data-sheet-nosum-why="the loads, aboard in some cases only, so the sum is the tare (TC1)">
      <thead><tr><th>Line</th><th>Item</th><th>Group</th><th class="num" data-sheet-mass>kg</th><th>Maturity</th><th class="num" data-sheet-sum="off">Growth</th><th class="num" data-sheet-sum="cog">CoG X</th><th class="num" data-sheet-sum="cog">CoG Y</th><th class="num" data-sheet-sum="cog">CoG Z</th><th>Aboard in</th><th>Source</th></tr></thead>
      <tbody>
        {r.schedule.map((s: any) => (
          <tr data-sheet-nosum={s.cases.length === r.cases.length ? undefined : ''}>
            <td>{s.iid}</td><td>{s.item}{s.note && s.note.includes('PLACEHOLDER') ? ' (placeholder)' : ''}</td><td>{s.group}</td>
            <td class="num">{n(s.mass_kg, 1)}</td><td>{s.maturity}</td><td class="num">{s.growth_pct} %</td>
            <td class="num">{n(s.cog?.[0])}</td><td class="num">{n(s.cog?.[1])}</td><td class="num">{n(s.cog?.[2])}</td>
            <td>{s.cases.length === r.cases.length ? 'all' : s.cases.join(', ')}</td>
            <td>{s.source.startsWith('http') ? <a href={s.source}>{new URL(s.source).hostname.replace('www.', '')}</a> : s.source}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
