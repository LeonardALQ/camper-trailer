---
// The services' tables for the Electrical, Plumbing and HVAC pages, from src/data/generated/services.json, which
// cad/sitedata.py writes with cad/services.py: the energy budget from research report 20's model output, the water
// budget, the circuits, the shedding order, the outlets and the ventilation modes in data/services.yaml.
import s from '../data/generated/services.json';
// The routed runs (H28): cad/routes_model.py writes routes.json with the trailer's build, from data/routes.yaml.
import routes from '../data/generated/routes.json';
import { withBase } from '../lib/url';

interface Props {
  kind: 'drawing' | 'energy' | 'autonomy' | 'recharge' | 'circuits' | 'shedding' | 'outlets' | 'water' | 'water-days'
    | 'modes' | 'design-days' | 'units' | 'lamps' | 'lamp-checks'
    | 'routes-legend' | 'cable-schedule' | 'pipe-schedule' | 'routes-lines' | 'svc-checks' | 'closest';
  number?: string;
  title?: string;
  model?: 'trailer-electrical' | 'trailer-plumbing';
}
const { kind, number, title, model } = Astro.props;
const d: any = s;
const rt: any = routes;
const ELEC = ['dc48', 'pv', 'dc24', 'dc12', 'data', 'ac230', 'lamps'];
const elec = rt.runs.filter((r: any) => ELEC.includes(r.system));
const wet = rt.runs.filter((r: any) => !ELEC.includes(r.system));
const side = model === 'trailer-plumbing' ? wet : elec;
// the routed runs on this page by the parts-list line that prices them
const lineTotals = Object.values(side.reduce((m: Record<string, any>, r: any) => {
  const k = r.priced_in ?? '-';
  const x = (m[k] ??= { line: k, length_m: 0, mass_kg: 0, aud: 0, runs: 0 });
  x.length_m += r.length_m; x.mass_kg += r.mass_kg; x.aud += r.aud; x.runs += 1;
  return m;
}, {})) as any[];
const pricedHere = (rt.priced as any[]).filter((p) => side.some((r: any) => p.kinds.includes(r.kind)));
const bd = rt.bd11;
const bdRouted = rt.bd11_routed_kg;
// the part of BD-11 that data/assemblies/trailer.yaml still holds as an allowance not yet given to a part (cad/services.py)
const bdFree: number | null = d.bd11?.unassigned_kg ?? null;
const n = (v: number | null | undefined, dp = 0) =>
  v == null ? '' : v.toLocaleString('en-AU', { minimumFractionDigits: dp, maximumFractionDigits: dp });
// a cable's conductor size, or its description where it has none (data, signal and lamp cables)
const size = (r: any) => (r.size == null ? r.cable : `${n(r.size, r.size % 1 ? 1 : 0)} mm²`);
const cases = d.energy.cases;
---

{kind === 'drawing' && number && (
  <figure class="sheet">
    <a href={withBase(`/downloads/drawings/${number}.pdf`)}><img src={withBase(`/drawings/${number}-preview.png`)} alt={`Drawing ${number}, ${title ?? ''}`} loading="lazy" /></a>
    <figcaption>{number} {title}. <a href={withBase(`/downloads/drawings/${number}.pdf`)}>PDF</a>, <a href={withBase(`/downloads/drawings/${number}.svg`)}>SVG</a></figcaption>
  </figure>
)}

{kind === 'energy' && (
  <div class="data-table">
    <table data-sheet-sum="sum">
      <thead><tr><th>Load group, kWh a day</th>{cases.map((c: any) => <th class="num" title={c.name}>{c.label}</th>)}</tr></thead>
      <tbody>
        {d.energy.groups.map((g: any) => (
          <tr><td>{g.group}</td>{cases.map((c: any) => <td class="num">{n(g.kwh[c.id], 2)}</td>)}</tr>
        ))}
        <tr class="row-total"><td>At the battery, a day</td>{cases.map((c: any) => <td class="num">{n(c.total, 2)}</td>)}</tr>
      </tbody>
    </table>
  </div>
)}

{kind === 'autonomy' && (
  <div class="data-table">
    <table data-sheet-sum="off">
      <thead><tr><th>Decision H3's checks</th><th class="num">Nominal kWh needed</th><th class="num">Usable kWh</th></tr></thead>
      <tbody>
        {d.autonomy.checks.map((c: any) => (<tr><td>{c.case}</td><td class="num">{n(c.nominal_kwh, 1)}</td><td class="num">{n(c.usable_kwh, 1)}</td></tr>))}
        <tr class="row-total"><td>Installed: {d.autonomy.bank}, {n(d.autonomy.kg)} kg</td><td class="num">{n(d.autonomy.kwh, 1)}</td><td class="num">{n(d.autonomy.kwh * 0.9, 1)}</td></tr>
      </tbody>
    </table>
  </div>
)}

{kind === 'recharge' && (
  <div class="data-table">
    <table data-sheet-sum="off">
      <thead><tr><th>Source</th><th class="num">Into the battery, W</th><th>Putting back one design hot day</th></tr></thead>
      <tbody>{d.recharge.map((r: any) => (<tr><td>{r.source}</td><td class="num">{n(r.watts)}</td><td>{r.result}</td></tr>))}</tbody>
    </table>
  </div>
)}

{kind === 'circuits' && (
  <div class="data-table">
    <table data-sheet-sum="sum">
      <thead><tr><th>Circuit</th><th>Load</th><th class="num">A</th><th class="num" data-sheet-sum="off">RCBO A</th><th>Control</th><th>Line</th></tr></thead>
      <tbody>{d.circuits.map((c: any) => (<tr><td>{c.id}</td><td>{c.load}</td><td class="num">{n(c.amps, 1)}</td><td class="num">{c.rcbo}</td><td>{c.control}</td><td>{c.at}</td></tr>))}</tbody>
    </table>
  </div>
)}

{kind === 'shedding' && (
  <div class="data-table">
    <table data-sheet-sum="off">
      <thead><tr><th>Step</th><th>Sheds</th><th>When</th><th>Then</th></tr></thead>
      <tbody>{d.shedding.map((r: any) => (<tr><td>{r.step}</td><td>{r.sheds}</td><td>{r.when}</td><td>{r.after}</td></tr>))}</tbody>
    </table>
  </div>
)}

{kind === 'outlets' && (
  <div class="data-table">
    <table data-sheet-sum="sum">
      <thead><tr><th>Zone</th><th>230 V</th><th>DC</th></tr></thead>
      <tbody>{d.outlets.map((r: any) => (<tr><td>{r.zone}</td><td>{r.ac}</td><td>{r.dc}</td></tr>))}</tbody>
    </table>
  </div>
)}

{kind === 'lamps' && (
  <div class="data-table">
    <table data-sheet-sum="off">
      <thead><tr><th>Mark</th><th>Device</th><th>Colour</th><th>Where</th><th class="num" data-sheet-sum="sum">Fitted</th><th>Across, mm</th><th>Height, mm</th><th>Along, mm</th><th>ADR 13/00</th></tr></thead>
      <tbody>
        {d.lamps.table.map((r: any) => (<tr><td>{r.mark} {r.id}</td><td>{r.name}</td><td>{r.colour}</td><td>{r.mount}</td><td class="num">{r.n}</td><td>{r.across}</td><td>{r.height}</td><td>{r.along}</td><td>{r.clauses.join(', ')}</td></tr>))}
        <tr><td>Plate</td><td>Number plate, {d.lamps.plate.w} x {d.lamps.plate.h} mm, upright</td><td></td><td>{d.lamps.plate.mount}</td><td class="num">1</td><td>{n(Math.abs(d.lamps.plate.y))} {d.lamps.plate.y < 0 ? 'kerb' : 'road'} side</td><td>{n(d.lamps.plate.z0)} to {n(d.lamps.plate.z1)}</td><td></td><td>VSB1 3.1</td></tr>
      </tbody>
    </table>
  </div>
)}

{kind === 'lamp-checks' && (
  <div class="data-table">
    <table data-sheet-sum="off">
      <thead><tr><th>ID</th><th>Check</th><th>Clause</th><th>The design, mm</th><th>The limit, mm</th><th>Result</th></tr></thead>
      <tbody>{d.lamps.checks.map((c: any) => (<tr><td>{c.id}</td><td>{c.what}</td><td>{c.clause}</td><td>{c.measured}</td><td>{c.limit}</td><td>{c.ok ? 'Pass' : 'Fail'}</td></tr>))}</tbody>
    </table>
  </div>
)}

{kind === 'water' && (
  <div class="data-table">
    <table data-sheet-sum="sum">
      <thead><tr><th>Use, two people a day</th><th class="num">Fresh L</th><th class="num">To grey L</th><th>Basis</th></tr></thead>
      <tbody>
        {d.water.daily.map((r: any) => (<tr><td>{r.use}</td><td class="num">{r.fresh_l}</td><td class="num">{r.grey_l}</td><td>{r.basis}</td></tr>))}
        <tr class="row-total"><td>A day without laundry</td><td class="num">{d.water.fresh_l}</td><td class="num">{d.water.grey_l}</td><td></td></tr>
        <tr><td>{d.water.wash.use}</td><td class="num">{d.water.wash.fresh_l}</td><td class="num">{d.water.wash.grey_l}</td><td>{d.water.wash.basis}</td></tr>
      </tbody>
    </table>
  </div>
)}

{kind === 'water-days' && (
  <div class="data-table">
    <table data-sheet-sum="off">
      <thead><tr><th>Water aboard</th><th class="num">L</th><th class="num">Washes a week</th><th class="num">Days it lasts</th></tr></thead>
      <tbody>{d.water.days.map((r: any) => (<tr><td>{r.case}</td><td class="num">{n(r.litres)}</td><td class="num">{r.washes_a_week}</td><td class="num">{n(r.days, 1)}</td></tr>))}</tbody>
    </table>
  </div>
)}

{kind === 'modes' && (
  <div class="data-table">
    <table data-sheet-sum="off">
      <thead><tr><th>Mode</th><th>e2 pairs, m³/h</th><th>Wet room extract</th><th>Top-up fan</th><th>RESPA-CF2</th><th>Split</th></tr></thead>
      <tbody>{d.modes.map((m: any) => (<tr><td>{m.mode}</td><td>{m.e2}</td><td>{m.ra}</td><td>{m.topup}</td><td>{m.respa}</td><td>{m.split}</td></tr>))}</tbody>
    </table>
  </div>
)}

{kind === 'design-days' && (
  <div class="data-table">
    <table data-sheet-sum="off">
      <thead><tr><th>Design day</th><th class="num">Heat to move, kWh</th><th class="num">Peak, kW</th><th class="num">Split from the battery, kWh</th></tr></thead>
      <tbody>{d.hvac.design_days.map((r: any) => (<tr><td>{r.case}</td><td class="num">{n(r.heat_kwh, 1)}</td><td class="num">{n(r.peak_kw, 2)}</td><td class="num">{n(r.battery_kwh, 1)}</td></tr>))}</tbody>
    </table>
  </div>
)}

{kind === 'units' && (
  <div class="data-table">
    <table data-sheet-sum="off">
      <thead><tr><th>Line</th><th>Unit</th><th>What it does</th><th>Where</th></tr></thead>
      <tbody>{d.hvac.units.map((u: any) => (<tr><td>{u.line}</td><td>{u.unit}</td><td>{u.does}</td><td>{u.where}</td></tr>))}</tbody>
    </table>
  </div>
)}

<style>
  .sheet img { width: 100%; height: auto; border: 1px solid var(--sl-color-gray-5); }
  .sheet figcaption { font-size: var(--sl-text-sm); }
  .route-legend { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.3rem 1.2rem; font-size: 0.9rem; }
  .route-legend li { display: flex; align-items: center; gap: 0.4rem; margin: 0; }
  .route-legend .swatch { display: inline-block; width: 1.6rem; height: 0.55rem; border-radius: 2px; }
  .route-legend .swatch.ghost { background: #9aa5ad; opacity: 0.35; }
  /* The cable, pipe and services check tables show their first five columns (I2-21). The table's Wrap, or the All
     columns button beside it, shows the rest. Without JavaScript the table is plain and shows every column. */
  .svc-cols :global(table.sheet-table:not(.sheet-wrap):not(.svc-all) :is(th, td):nth-child(n + 6)) { display: none; }
</style>

<script>
  // The All columns button in the tools of each .svc-cols table, once the spreadsheet tools have built them
  // (src/scripts/sheet.ts). A resize event lets those tools measure the frame again.
  function columns() {
    for (const holder of Array.from(document.querySelectorAll('.svc-cols'))) {
      const table = holder.querySelector('table');
      const tools = holder.querySelector('.sheet-tools');
      if (!table || !tools || tools.querySelector('.svc-all-btn')) continue;
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'svc-all-btn';
      b.textContent = 'All columns';
      b.title = 'Show every column, or only the first five';
      b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', () => {
        const on = table.classList.toggle('svc-all');
        b.setAttribute('aria-pressed', String(on));
        window.dispatchEvent(new Event('resize'));
      });
      tools.insertBefore(b, tools.querySelector('.sheet-msg'));
    }
  }
  if (document.readyState === 'complete') columns();
  else window.addEventListener('load', columns);
</script>

{kind === 'routes-legend' && (
  <ul class="route-legend">
    {rt.legend.filter((l: any) => l.model === (model ?? 'trailer-electrical')).map((l: any) => (
      <li><span class="swatch" style={`background:${l.colour}`}></span>{l.label}</li>))}
    {(model ?? 'trailer-electrical') === 'trailer-electrical' && (
      <li><span class="swatch" style="background:#4d4d4d;opacity:0.5"></span>The 230 V conduits and the cable supports, see-through</li>)}
    <li><span class="swatch ghost"></span>Body, chassis and fit-out, see-through</li>
  </ul>
)}

{kind === 'cable-schedule' && (
  <div class="data-table svc-cols">
    <table data-sheet-sum="sum">
      <thead><tr><th>Run</th><th>Feeds</th><th>Size</th><th>Length, m</th><th data-sheet-sum="off">Drop, %</th>
        <th>Cable</th><th>System</th><th data-sheet-sum="off">Current, A</th><th>Protection</th><th>Why this size</th>
        <th>Mass, kg</th><th>AUD</th><th>Priced in</th></tr></thead>
      <tbody>{elec.map((r: any) => (
        <tr><td>{r.id}</td><td>{r.feeds}</td><td>{size(r)}</td><td>{n(r.length_m, 2)}</td><td>{r.vd_pct == null ? '' : n(r.vd_pct, 2)}</td>
          <td>{r.cable}</td><td>{r.system_label}</td><td>{r.amps == null ? '' : n(r.amps, r.amps % 1 ? 1 : 0)}</td><td>{r.protection}</td>
          <td>{r.size_why}</td><td>{n(r.mass_kg, 2)}</td><td>{n(r.aud, 2)}</td><td>{r.priced_in}</td></tr>))}</tbody>
    </table>
  </div>
)}

{kind === 'pipe-schedule' && (
  <div class="data-table svc-cols">
    <table data-sheet-sum="sum">
      <thead><tr><th>Run</th><th>Feeds</th><th>Pipe or hose</th><th>Length, m</th><th>Fittings</th><th>System</th><th>Mass, kg</th><th>AUD</th><th>Priced in</th></tr></thead>
      <tbody>{wet.map((r: any) => (
        <tr><td>{r.id}</td><td>{r.feeds}</td><td>{r.cable}</td><td>{n(r.length_m, 2)}</td><td>{r.fittings}</td>
          <td>{r.system_label}</td><td>{n(r.mass_kg, 2)}</td><td>{n(r.aud, 2)}</td><td>{r.priced_in}</td></tr>))}</tbody>
    </table>
  </div>
)}

{kind === 'routes-lines' && (
  <>
    <div class="data-table">
      <table data-sheet-sum="sum">
        <thead><tr><th>Priced in</th><th>Runs</th><th>Routed length, m</th><th>Routed mass, kg</th><th>Routed price, AUD</th></tr></thead>
        <tbody>{lineTotals.map((x: any) => (<tr><td>{x.line}</td><td>{x.runs}</td><td>{n(x.length_m, 1)}</td><td>{n(x.mass_kg, 2)}</td><td>{n(x.aud, 2)}</td></tr>))}</tbody>
      </table>
    </div>
    <div class="data-table">
      <table data-sheet-sum="off">
        <thead><tr><th>Line</th><th>Priced item</th><th>Priced</th><th>Routed</th><th>Larger</th></tr></thead>
        <tbody>{pricedHere.map((p: any) => (<tr><td>{p.line}</td><td>{p.item}</td><td>{n(p.quantity)} {p.unit}</td><td>{n(p.routed, 1)} {p.unit}</td>
          <td>{p.larger === 'routed' ? 'Routed: the line is to be raised' : 'Priced'}</td></tr>))}</tbody>
      </table>
    </div>
    {bd && (
      <p>BD-11, the line for {bd.item.toLowerCase()}, is {n(bd.mass_kg, 1)} kg. The routed cables and pipes it prices, on both
        pages, weigh {n(bdRouted, 1)} kg{bdFree == null ? '.' : `, and ${n(bdFree, 1)} kg of the line is still unassigned, kept for parts not yet designed.`}
        {bdRouted > bd.mass_kg ? ' The routed runs weigh more than the whole line, so BD-11 is to be raised to them.' : ''}</p>
    )}
  </>
)}

{kind === 'svc-checks' && (
  <div class="data-table svc-cols">
    <table data-sheet-sum="off">
      <thead><tr><th>Check</th><th>Result</th><th>What it checks</th><th>Measured</th><th>Limit</th><th>Governing</th><th>Source</th></tr></thead>
      <tbody>{rt.checks.map((c: any) => (
        <tr><td>{c.id}</td><td>{c.ok ? 'Pass' : `${c.severity === 'report' ? 'Reported' : 'Fail'}: ${c.detail}`}</td><td>{c.title}</td><td>{c.measured == null ? '' : `${c.measured} ${c.unit}`}</td>
          <td>{c.limit}</td><td>{c.governing}</td><td>{c.source}</td></tr>))}</tbody>
    </table>
  </div>
)}

{kind === 'closest' && (
  <div class="data-table">
    <table data-sheet-sum="off">
      <thead><tr><th>Run</th><th>Part</th><th>Clear, mm</th></tr></thead>
      <tbody>{rt.closest.map((g: any) => (<tr><td>{g.run}</td><td>{g.part} {g.name}</td><td>{n(g.gap, 1)}</td></tr>))}</tbody>
    </table>
  </div>
)}

