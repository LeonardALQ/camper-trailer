---
// The services' tables for the Electrical, Plumbing and HVAC pages, from src/data/generated/services.json, which
// cad/sitedata.py writes with cad/services.py: the energy budget from research report 20's model output, the water
// budget, the circuits, the shedding order, the outlets and the ventilation modes in data/services.yaml.
import s from '../data/generated/services.json';
import { withBase } from '../lib/url';

interface Props {
  kind: 'drawing' | 'energy' | 'autonomy' | 'recharge' | 'circuits' | 'shedding' | 'outlets' | 'cables' | 'water' | 'water-days'
    | 'modes' | 'design-days' | 'units';
  number?: string;
  title?: string;
}
const { kind, number, title } = Astro.props;
const d: any = s;
const n = (v: number | null | undefined, dp = 0) =>
  v == null ? '' : v.toLocaleString('en-AU', { minimumFractionDigits: dp, maximumFractionDigits: dp });
const cases = d.energy.cases;
---

{kind === 'drawing' && number && (
  <figure class="sheet">
    <a href={withBase(`/downloads/drawings/${number}.pdf`)}><img src={withBase(`/drawings/${number}-preview.png`)} alt={`Drawing ${number}, ${title ?? ''}`} loading="lazy" /></a>
    <figcaption>{number} {title}. <a href={withBase(`/downloads/drawings/${number}.pdf`)}>PDF</a>, <a href={withBase(`/downloads/drawings/${number}.svg`)}>SVG</a></figcaption>
  </figure>
)}

{kind === 'energy' && (
  <div class="data-table" data-sheet="off">
    <table>
      <thead><tr><th>Load group, kWh a day</th>{cases.map((c: any) => <th class="num" title={c.name}>{c.label}</th>)}</tr></thead>
      <tbody>
        {d.energy.groups.map((g: any) => (
          <tr><td>{g.group}</td>{cases.map((c: any) => <td class="num">{n(g.kwh[c.id], 2)}</td>)}</tr>
        ))}
        <tr class="row-total"><td>At the battery, a day</td>{cases.map((c: any) => <td class="num">{n(c.total, 2)}</td>)}</tr>
      </tbody>
    </table>
  </div>
)}

{kind === 'autonomy' && (
  <div class="data-table" data-sheet="off">
    <table>
      <thead><tr><th>Decision H3's checks</th><th class="num">Nominal kWh needed</th><th class="num">Usable kWh</th></tr></thead>
      <tbody>
        {d.autonomy.checks.map((c: any) => (<tr><td>{c.case}</td><td class="num">{n(c.nominal_kwh, 1)}</td><td class="num">{n(c.usable_kwh, 1)}</td></tr>))}
        <tr class="row-total"><td>Installed: {d.autonomy.bank}, {n(d.autonomy.kg)} kg</td><td class="num">{n(d.autonomy.kwh, 1)}</td><td class="num">{n(d.autonomy.kwh * 0.9, 1)}</td></tr>
      </tbody>
    </table>
  </div>
)}

{kind === 'recharge' && (
  <div class="data-table" data-sheet="off">
    <table>
      <thead><tr><th>Source</th><th class="num">Into the battery, W</th><th>Putting back one design hot day</th></tr></thead>
      <tbody>{d.recharge.map((r: any) => (<tr><td>{r.source}</td><td class="num">{n(r.watts)}</td><td>{r.result}</td></tr>))}</tbody>
    </table>
  </div>
)}

{kind === 'circuits' && (
  <div class="data-table">
    <table>
      <thead><tr><th>Circuit</th><th>Load</th><th class="num">A</th><th class="num">RCBO A</th><th>Control</th><th>Line</th></tr></thead>
      <tbody>{d.circuits.map((c: any) => (<tr><td>{c.id}</td><td>{c.load}</td><td class="num">{n(c.amps, 1)}</td><td class="num">{c.rcbo}</td><td>{c.control}</td><td>{c.at}</td></tr>))}</tbody>
    </table>
  </div>
)}

{kind === 'shedding' && (
  <div class="data-table" data-sheet="off">
    <table>
      <thead><tr><th>Step</th><th>Sheds</th><th>When</th><th>Then</th></tr></thead>
      <tbody>{d.shedding.map((r: any) => (<tr><td>{r.step}</td><td>{r.sheds}</td><td>{r.when}</td><td>{r.after}</td></tr>))}</tbody>
    </table>
  </div>
)}

{kind === 'outlets' && (
  <div class="data-table" data-sheet="off">
    <table>
      <thead><tr><th>Zone</th><th>230 V</th><th>DC</th></tr></thead>
      <tbody>{d.outlets.map((r: any) => (<tr><td>{r.zone}</td><td>{r.ac}</td><td>{r.dc}</td></tr>))}</tbody>
    </table>
  </div>
)}

{kind === 'cables' && (
  <div class="data-table">
    <table>
      <thead><tr><th>Run</th><th>Current</th><th>Fuse</th><th>Cable</th><th>Length</th></tr></thead>
      <tbody>{d.cables.map((r: any) => (<tr><td>{r.run}</td><td>{r.current}</td><td>{r.fuse}</td><td>{r.cable}</td><td>{r.length}</td></tr>))}</tbody>
    </table>
  </div>
)}

{kind === 'water' && (
  <div class="data-table" data-sheet="off">
    <table>
      <thead><tr><th>Use, two people a day</th><th class="num">Fresh L</th><th class="num">To grey L</th><th>Basis</th></tr></thead>
      <tbody>
        {d.water.daily.map((r: any) => (<tr><td>{r.use}</td><td class="num">{r.fresh_l}</td><td class="num">{r.grey_l}</td><td>{r.basis}</td></tr>))}
        <tr class="row-total"><td>A day without laundry</td><td class="num">{d.water.fresh_l}</td><td class="num">{d.water.grey_l}</td><td></td></tr>
        <tr><td>{d.water.wash.use}</td><td class="num">{d.water.wash.fresh_l}</td><td class="num">{d.water.wash.grey_l}</td><td>{d.water.wash.basis}</td></tr>
      </tbody>
    </table>
  </div>
)}

{kind === 'water-days' && (
  <div class="data-table" data-sheet="off">
    <table>
      <thead><tr><th>Water aboard</th><th class="num">L</th><th class="num">Washes a week</th><th class="num">Days it lasts</th></tr></thead>
      <tbody>{d.water.days.map((r: any) => (<tr><td>{r.case}</td><td class="num">{n(r.litres)}</td><td class="num">{r.washes_a_week}</td><td class="num">{n(r.days, 1)}</td></tr>))}</tbody>
    </table>
  </div>
)}

{kind === 'modes' && (
  <div class="data-table" data-sheet="off">
    <table>
      <thead><tr><th>Mode</th><th>e2 pairs, m³/h</th><th>Wet room extract</th><th>Top-up fan</th><th>RESPA-CF2</th><th>Split</th></tr></thead>
      <tbody>{d.modes.map((m: any) => (<tr><td>{m.mode}</td><td>{m.e2}</td><td>{m.ra}</td><td>{m.topup}</td><td>{m.respa}</td><td>{m.split}</td></tr>))}</tbody>
    </table>
  </div>
)}

{kind === 'design-days' && (
  <div class="data-table" data-sheet="off">
    <table>
      <thead><tr><th>Design day</th><th class="num">Heat to move, kWh</th><th class="num">Peak, kW</th><th class="num">Split from the battery, kWh</th></tr></thead>
      <tbody>{d.hvac.design_days.map((r: any) => (<tr><td>{r.case}</td><td class="num">{n(r.heat_kwh, 1)}</td><td class="num">{n(r.peak_kw, 2)}</td><td class="num">{n(r.battery_kwh, 1)}</td></tr>))}</tbody>
    </table>
  </div>
)}

{kind === 'units' && (
  <div class="data-table">
    <table>
      <thead><tr><th>Line</th><th>Unit</th><th>What it does</th><th>Where</th></tr></thead>
      <tbody>{d.hvac.units.map((u: any) => (<tr><td>{u.line}</td><td>{u.unit}</td><td>{u.does}</td><td>{u.where}</td></tr>))}</tbody>
    </table>
  </div>
)}

<style>
  .sheet img { width: 100%; height: auto; border: 1px solid var(--sl-color-gray-5); }
  .sheet figcaption { font-size: var(--sl-text-sm); }
</style>
