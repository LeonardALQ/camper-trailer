---
// Check results measured on the model (build/checks/checks.json). Failures show in red with the measured gap.
import checks from '../data/generated/checks.json';

const short: Record<string, string> = { 'Aprilia Tuareg 660 Rally': 'Tuareg', 'Triumph Street Triple 765': 'Street Triple' };
const rowClass = (r: any) => (r.ok ? '' : r.severity === 'fail' ? 'row-fail' : 'row-report');
const statusClass = (r: any) => (r.ok ? 'status-pass' : r.severity === 'fail' ? 'status-fail' : 'status-report');
const measured = (r: any) =>
  r.type === 'contact'
    ? `${r.pairs.filter((p: any) => p.ok).length} of ${r.pairs.length} pairs touch, largest overlap ${r.overlap_mm3} mm³`
    : r.type === 'height'
      ? `top at ${r.measured_mm} mm (${r.margin_mm} mm spare)`
      : r.type === 'landing'
        ? `foot ${Math.abs(r.measured_mm).toFixed(1)} mm ${r.measured_mm < 0 ? 'below' : 'above'} the floor`
        : `${r.measured_mm} mm`;
const gives = (r: any) =>
  r.type === 'landing'
    ? `a foot ${Math.abs(r.fix.measured_mm).toFixed(1)} mm ${r.fix.measured_mm < 0 ? 'below' : 'above'} the floor`
    : `${r.fix.measured_mm} mm`;
---

<div class="data-table">
  <table>
    <thead>
      <tr><th>ID</th><th>Check</th><th>Limit</th><th>Measured</th><th>Result</th><th>Closest parts</th></tr>
    </thead>
    <tbody>
      {checks.results.map((r: any) => (
        <tr class={rowClass(r)}>
          <td>{r.id}</td>
          <td>{r.title}{r.sub ? ` (${short[r.sub] ?? r.sub})` : ''}{r.added_by_build ? ' (sensitivity added by this build)' : ''}</td>
          <td>{r.limit}</td>
          <td>{measured(r)}</td>
          <td class={statusClass(r)}>{r.status}{r.severity === 'report' ? ' (reported only)' : ''}</td>
          <td>
            {r.governing}
            {r.fix && (
              <><br /><em>Smallest change that passes: {r.fix.words}, {r.fix.param} from {r.fix.baseline} to {r.fix.value} ({r.fix.change_mm > 0 ? '+' : ''}{r.fix.change_mm} mm), which gives {gives(r)}.</em></>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="muted">
  Measured on the B-rep model with OCCT's exact shape-to-shape distance (pytest, data revision {checks.git}). Limits are
  DESIGN.md's, plus CLR-07 added in revision B, and they are never changed to make a check pass.
</p>
