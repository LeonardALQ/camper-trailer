---
// Full bill of materials, generated from data/parts/*.yaml through build/bom/bom.json.
import bom from '../data/generated/bom.json';

const groups: [string, string][] = [
  ['garage', 'Garage'],
  ['bed', 'Bed'],
  ['partitions', 'Partitions and living-side door'],
  ['fixings', 'Fixings, adhesives and isolation'],
  ['access', 'Access and safety'],
];
const fmtQty = (l: any) =>
  l.basis === 'declared' ? `${l.qty_bom} ${l.unit ?? ''}` : `${Number(l.qty).toFixed(2)} ${l.unit} (modelled)`;
const fmtUnit = (l: any) =>
  l.basis === 'per_length' ? `${l.unit_mass} /m` : l.basis === 'per_area' ? `${l.unit_mass} /m²` : l.unit_mass == null ? '' : `${l.unit_mass}`;
const linkLabel = (k: string) => k.replace(/_/g, ' ');
---

{groups.map(([g, title]) => {
  const lines = bom.lines.filter((l: any) => l.group === g);
  const total = lines.reduce((s: number, l: any) => s + l.mass_kg, 0);
  return (
    <>
      <h3>{title}</h3>
      <div class="data-table">
        <table>
          <thead>
            <tr><th>ID</th><th>Item and product</th><th>Qty</th><th class="num">Unit kg</th><th class="num">Total kg</th><th>Maturity</th><th>Size and rating</th><th>Links</th><th>Notes</th></tr>
          </thead>
          <tbody>
            {lines.map((l: any) => (
              <tr>
                <td>{l.id}</td>
                <td>{l.item}<br /><span class="muted">{l.product}{l.part_no && !String(l.product ?? '').includes(l.part_no) ? ` (${l.part_no})` : ''}</span></td>
                <td>{fmtQty(l)}</td>
                <td class="num">{fmtUnit(l)}</td>
                <td class="num">{l.mass_kg.toFixed(2)}</td>
                <td>{l.maturity}</td>
                <td>{[l.size, l.rating].filter(Boolean).join('. ')}</td>
                <td>
                  {Object.entries(l.links ?? {}).map(([k, u]) => (<><a href={u as string}>{linkLabel(k)}</a><br /></>))}
                  {l.stockist_au && <><a href={l.stockist_au}>AU stockist</a><br /></>}
                  {!l.stockist_au && <span class="muted">No AU stockist known</span>}
                </td>
                <td>{l.notes}{l.mass_note ? ` Mass: ${l.mass_note}.` : ''}</td>
              </tr>
            ))}
            <tr><td></td><td>Subtotal</td><td></td><td></td><td class="num">{total.toFixed(1)}</td><td colspan="4"></td></tr>
          </tbody>
        </table>
      </div>
    </>
  );
})}
<p>
  Module empty: {bom.totals.module_empty.toFixed(2)} kg. Removable kit (chocks, straps, loops, harness,
  ramp and winch): {bom.totals.removable.toFixed(1)} kg. With both bikes:
  {(bom.totals.module_empty + bom.bikes.reduce((s: number, b: any) => s + b.mass_kg, 0)).toFixed(2)} kg.
</p>
<p>
  The garage-bed/BOM.md parts list rounds each line to 0.1 kg. Rounded the same way, these lines add up to
  {bom.lines.reduce((s: number, l: any) => s + Math.round(l.mass_kg * 10) / 10, 0).toFixed(1)} kg empty, which is
  the BOM.md total. The unrounded sum above is a little lower because of that rounding.
</p>
