---
// three-cad-viewer island for one model (a viewer.json under /models/). Pointing at a part shows what it is, and
// clicking it opens a card that hides it, shows only it or finds its row in the page's tables (S-01, S-02). The part
// data is the .parts.json written beside the model (cad/partsmeta.py).
import { withBase } from '../lib/url';

interface Props {
  src?: string;
  height?: number;
}
const { src = withBase('/models/trailer.json'), height = 520 } = Astro.props;
const rev = process.env.GIT_REV ?? 'dev';
const parts = src.replace(/\.json$/, '.parts.json');
---

<cad-viewer class="not-content" data-src={`${src}?v=${rev}`} data-parts={`${parts}?v=${rev}`}
  data-drawings={withBase('/drawings/')} data-height={height}>
  <p class="cad-loading">Loading the 3D model (about 3 MB)...</p>
</cad-viewer>
<p class="cad-help">
  Drag to rotate, right-drag to pan, and pinch or hold Ctrl (⌘ on a Mac) while you scroll to zoom, since plain
  scrolling moves the page. Point at a part to see what it is, and click it for a card that hides it, shows only it or
  finds its row in the tables.
</p>

<style>
  cad-viewer {
    display: block;
    margin: 1rem 0 0.4rem 0;
    position: relative;
    overflow: hidden;
    user-select: none;
  }
  .cad-help {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    margin-top: 0.2rem;
  }
  cad-viewer :global(.cad-wheel-hint) {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    padding: 0.5rem 0.9rem;
    border-radius: 0.4rem;
    background: rgba(20, 20, 20, 0.78);
    color: #fff;
    font-size: 0.85rem;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
    z-index: 20;
  }
  cad-viewer :global(.cad-wheel-hint.show) {
    opacity: 1;
  }
  cad-viewer :global(.cad-tip) {
    position: absolute;
    z-index: 21;
    max-width: 22rem;
    padding: 0.35rem 0.55rem;
    border-radius: 0.3rem;
    background: rgba(20, 20, 20, 0.88);
    color: #fff;
    font-size: 0.78rem;
    line-height: 1.35;
    pointer-events: none;
  }
  cad-viewer :global(.cad-tip b) {
    font-family: var(--__sl-font-mono, monospace);
  }
  cad-viewer :global(.cad-tip .dim) {
    color: #c8ccd4;
  }
  cad-viewer :global(.cad-card) {
    position: absolute;
    z-index: 22;
    right: 8px;
    top: 96px;
    width: 21rem;
    max-height: calc(100% - 112px);
    overflow: auto;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    font-size: 0.8rem;
    line-height: 1.4;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    user-select: text;
  }
  cad-viewer :global(.cad-card h4) {
    margin: 0 1.6rem 0.4rem 0;
    font-size: 0.9rem;
  }
  cad-viewer :global(.cad-card h4 b) {
    font-family: var(--__sl-font-mono, monospace);
    margin-right: 0.35rem;
  }
  cad-viewer :global(.cad-card dl) {
    display: grid;
    grid-template-columns: 4.6rem 1fr;
    gap: 0.15rem 0.5rem;
    margin: 0 0 0.5rem 0;
  }
  cad-viewer :global(.cad-card dt) {
    color: var(--sl-color-gray-3);
  }
  cad-viewer :global(.cad-card dd) {
    margin: 0;
    overflow-wrap: anywhere;
  }
  cad-viewer :global(.cad-card .close) {
    position: absolute;
    right: 0.4rem;
    top: 0.3rem;
    border: 0;
    background: none;
    color: var(--sl-color-gray-3);
    font-size: 1.1rem;
    cursor: pointer;
  }
  cad-viewer :global(.cad-card .acts) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  cad-viewer :global(.cad-card .acts button) {
    font: inherit;
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-white);
    cursor: pointer;
  }
  cad-viewer :global(.cad-card .acts button:hover) {
    border-color: var(--sl-color-accent);
  }
  cad-viewer :global(.cad-card .msg) {
    margin-top: 0.35rem;
    color: var(--sl-color-text-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    cad-viewer :global(.cad-wheel-hint) {
      transition: none;
    }
  }
</style>

<script>
  import { Display, Viewer } from 'three-cad-viewer';
  import 'three-cad-viewer/css';

  interface Part {
    id: string;
    iid: string;
    name: string;
    group: string | null;
    material: string | null;
    mass_kg: number | null;
    mass_growth_kg: number | null;
    maturity: string | null;
    source: string | null;
    drawing: string | null;
    price_aud: number | null;
    price_basis: string | null;
    price_note: string | null;
    load: string | null;
    paths: string[];
  }
  interface PartsFile {
    parts: Record<string, Part>;
    nodes: Record<string, [string, string]>;
  }
  interface Hit {
    node: string;     // the tree path of the part: a leaf, or the group that holds a fitting's or a bike's pieces
    label: string;
    part: Part | null;
  }

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  // The model's tree names have each "/" turned into "-", so compare names without them.
  const same = (s: string) => s.replace(/[/-]/g, ' ').replace(/\s+/g, ' ').trim().toLowerCase();
  const kg = (v: number | null | undefined) =>
    v == null ? '' : `${v.toLocaleString('en-AU', { minimumFractionDigits: 1, maximumFractionDigits: v < 10 ? 2 : 1 })} kg`;
  // The tree leaf that owns a picked face, edge or vertex (three-cad-viewer's own rule).
  const leafPath = (info: { solidPath: string | null; path: string }) =>
    info.solidPath ?? info.path.replace(/\/(faces|edges|vertices)\/[^/]+$/, '');

  class CadViewerElement extends HTMLElement {
    viewer: any = null;
    data: PartsFile = { parts: {}, nodes: {} };
    partKeys: string[] = [];
    tip = document.createElement('div');
    card = document.createElement('div');
    hover: string | null = null;
    pinned: Hit | null = null;
    marked: string[] = [];
    down: { x: number; y: number } | null = null;
    last: PointerEvent | null = null;

    async connectedCallback() {
      const [shapes, parts] = await Promise.all([
        fetch(this.dataset.src!).then((r) => r.json()),
        fetch(this.dataset.parts!).then((r) => (r.ok ? r.json() : null)).catch(() => null),
      ]);
      if (parts) this.data = parts;
      this.innerHTML = '';
      const treeWidth = 250;
      const cadWidth = Math.max(420, this.clientWidth - treeWidth - 4);
      const height = Number(this.dataset.height ?? 520);
      const opts = { cadWidth, height, treeWidth, glass: false, tools: true, measureTools: true, explodeTool: true };
      const display = new Display(this, { ...opts, theme: 'light', pinning: false });
      // A change of the tree's checkboxes arrives here, so the part card shows Hide or Show to match.
      const viewer = new Viewer(display, { ...opts, target: [0, 0, 0], up: 'Z' } as any, (change: any) => {
        if (change.states) this.showCard();
      });
      viewer.render(
        shapes,
        { edgeColor: 0x404040, ambientIntensity: 1.0, directIntensity: 1.1, metalness: 0.3, roughness: 0.65, defaultOpacity: 0.5, normalLen: 0 },
        { ...opts, up: 'Z', ortho: true, collapse: 1 } as any,
      );
      viewer.resizeCadView(cadWidth, treeWidth, height, false);
      this.viewer = viewer;
      (this as any).viewer = viewer;

      // Let the mouse wheel scroll the page over the model too. The model only zooms with Ctrl or Cmd held, or
      // with a trackpad pinch, which the browser sends as a wheel event with Ctrl held. Stopping the event on the
      // way down keeps it away from the viewer's zoom handler, and the browser then scrolls the page as normal.
      const hint = document.createElement('div');
      hint.className = 'cad-wheel-hint';
      hint.textContent = 'To zoom the model, pinch or hold Ctrl (⌘ on a Mac) while you scroll';
      this.append(hint);
      let hideHint = 0;
      this.addEventListener(
        'wheel',
        (e) => {
          if (e.ctrlKey || e.metaKey) return;
          e.stopPropagation();
          const canvas = (e.target as Element).closest('canvas');
          if (!canvas) return;
          const c = canvas.getBoundingClientRect();
          const me = this.getBoundingClientRect();
          hint.style.left = `${c.left - me.left + c.width / 2}px`;
          hint.style.top = `${c.top - me.top + c.height / 2}px`;
          hint.classList.add('show');
          clearTimeout(hideHint);
          hideHint = window.setTimeout(() => hint.classList.remove('show'), 1500);
        },
        { capture: true, passive: true },
      );

      this.setupParts();

      // Reserve the full height of the viewer (canvas, tree and info panel) so nothing overlaps the text below.
      const reserve = () => {
        const top = this.getBoundingClientRect().top;
        let bottom = top;
        this.querySelectorAll('*').forEach((el) => {
          if (el === this.card || el === this.tip || this.card.contains(el)) return;
          const r = (el as HTMLElement).getBoundingClientRect();
          if (r.height > 0 && r.bottom > bottom) bottom = r.bottom;
        });
        this.style.height = `${Math.ceil(bottom - top) + 8}px`;
      };
      reserve();
      setTimeout(reserve, 300);
      document.body.dataset.cadReady = 'yes';
    }

    // ---------------------------------------------------------------- hover, click and the part card
    setupParts() {
      const v = this.viewer;
      const canvas: HTMLCanvasElement = v.renderer.domElement;
      this.tip.className = 'cad-tip';
      this.tip.hidden = true;
      this.card.className = 'cad-card';
      this.card.hidden = true;
      this.append(this.tip, this.card);
      // Hover picks whole solids by default, so the highlight covers the part. The filter in the toolbar still
      // switches to faces, edges or vertices for measuring.
      v.display.shapeFilterDropDownMenu?.setValue?.('Solid');
      // The viewer picks what is under the cursor once per frame for its own hover highlight. Its result is read
      // after each render, so the tooltip costs no second pick.
      v.onAfterRender = () => {
        const obj = v.lastObject;
        const path = obj?.info ? leafPath(obj.info) : null;
        if (path !== this.hover) {
          this.hover = path;
          this.showTip();
        }
      };
      canvas.addEventListener('pointermove', (e) => {
        this.last = e;
        if (e.buttons) this.tip.hidden = true;
        else this.placeTip(e);
      });
      canvas.addEventListener('pointerleave', () => {
        this.hover = null;
        this.tip.hidden = true;
      });
      canvas.addEventListener('pointerdown', (e) => {
        this.down = e.button === 0 ? { x: e.clientX, y: e.clientY } : null;
        this.tip.hidden = true;
      });
      // A click (no drag) on a part pins its card, a click on empty space closes it. The measuring tools use clicks
      // themselves, so the card stays out of their way. The click picks again at its own position, because the
      // hover result can lag a fast click by a frame.
      canvas.addEventListener('pointerup', (e) => {
        const d = this.down;
        this.down = null;
        if (!d || Math.hypot(e.clientX - d.x, e.clientY - d.y) > 4 || v.state.get('activeTool')) return;
        const r = canvas.getBoundingClientRect();
        const hit = v.idPicker?.pickAt(e.clientX - r.left, e.clientY - r.top, { topoFilter: ['solid'] }) ?? v.lastObject;
        const path = hit?.info ? leafPath(hit.info) : null;
        if (path && this.visible(path)) this.pin(this.resolve(path));
        else this.unpin();
      });
      this.card.addEventListener('click', (e) => {
        const act = (e.target as Element).closest('button')?.dataset.act;
        if (act) this.act(act);
      });
      const parts = Object.values(this.data.parts);
      this.partKeys = [...new Set(parts.flatMap((p) => [p.iid, p.id]))];
      document.dispatchEvent(new CustomEvent('ct:parts-ready', { detail: { ids: this.partKeys } }));
    }

    // The part a tree path belongs to: the path itself, or the nearest ancestor that is a part.
    resolve(path: string): Hit {
      for (let p = path; p.lastIndexOf('/') > 0; p = p.slice(0, p.lastIndexOf('/'))) {
        const n = this.data.nodes[p];
        if (n) return { node: p, label: n[1], part: this.data.parts[n[0]] ?? null };
      }
      return { node: path, label: path.slice(path.lastIndexOf('/') + 1), part: null };
    }

    showTip() {
      if (!this.hover || this.down) {
        this.tip.hidden = true;
        return;
      }
      const h = this.resolve(this.hover);
      const p = h.part;
      const title = p && same(p.name) === same(h.label) ? p.name : h.label;
      const facts = p ? [p.material, p.mass_kg != null ? `${kg(p.mass_kg)}${p.maturity ? ` (${p.maturity})` : ''}` : ''] : [];
      this.tip.innerHTML = `${p ? `<b>${esc(p.iid)}</b> ` : ''}${esc(title)}`
        + facts.filter(Boolean).map((f) => `<br><span class="dim">${esc(f!)}</span>`).join('');
      this.tip.hidden = false;
      if (this.last) this.placeTip(this.last);
    }

    placeTip(e: PointerEvent) {
      if (this.tip.hidden) return;
      const me = this.getBoundingClientRect();
      const c = (e.target as Element).getBoundingClientRect();
      const w = this.tip.offsetWidth;
      const h = this.tip.offsetHeight;
      let x = e.clientX - me.left + 14;
      let y = e.clientY - me.top + 16;
      if (e.clientX + 14 + w > c.right) x = e.clientX - me.left - w - 10;
      if (e.clientY + 16 + h > c.bottom) y = e.clientY - me.top - h - 10;
      this.tip.style.left = `${Math.max(0, x)}px`;
      this.tip.style.top = `${Math.max(0, y)}px`;
    }

    pin(hit: Hit) {
      this.pinned = hit;
      this.say('');
      this.showCard();
    }

    unpin() {
      this.pinned = null;
      this.card.hidden = true;
      this.unmark();
    }

    visible(path: string): boolean {
      const s = this.viewer.getState(path);
      return !s || s[0] !== 0;
    }

    showCard() {
      const h = this.pinned;
      if (!h) return;
      const p = h.part;
      const rows: [string, string][] = [];
      const base = this.dataset.drawings ?? '/drawings/';
      if (p) {
        if (p.name && same(p.name) !== same(h.label)) rows.push(['Line', esc(p.name)]);
        if (p.group) rows.push(['Group', esc(p.group)]);
        rows.push(['Material', p.material ? esc(p.material) : '<span class="dim">Not recorded yet</span>']);
        if (p.mass_kg != null) {
          rows.push(['Mass', `${kg(p.mass_kg)}${p.maturity ? `, ${esc(p.maturity)}` : ''}${p.mass_growth_kg != null && p.mass_growth_kg !== p.mass_kg ? `. ${kg(p.mass_growth_kg)} with the growth allowance` : ''}`]);
        }
        if (p.load && p.load !== 'tare') rows.push(['Load', `Carried as ${esc(p.load)}, so its mass is in the load cases`]);
        if (p.source) rows.push(['Source', /^https?:\/\//.test(p.source) ? `<a href="${esc(p.source)}">${esc(new URL(p.source).hostname)}</a>` : esc(p.source)]);
        if (p.drawing) rows.push(['Drawing', `<a href="${esc(base)}#${p.drawing.toLowerCase()}">${esc(p.drawing)}</a>`]);
        const cents = (v: number) => v.toLocaleString('en-AU', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const priceNote = p.price_note ? `. ${esc(p.price_note)}` : '';
        rows.push(['Price', p.price_aud != null
          ? `AUD ${cents(p.price_aud)}${p.price_basis ? `, ${esc(p.price_basis)}` : ''}${priceNote}`
          : p.price_note ? `<span class="dim">${esc(p.price_note)}</span>` : '<span class="dim">Not priced yet</span>']);
      }
      const shown = this.visible(h.node);
      const title = p && same(p.name) === same(h.label) ? p.name : h.label;
      this.card.innerHTML = `<button class="close" type="button" data-act="close" title="Close" aria-label="Close">×</button>`
        + `<h4>${p ? `<b>${esc(p.iid)}</b>` : ''}${esc(title)}</h4>`
        + (rows.length ? `<dl>${rows.map(([k, val]) => `<dt>${k}</dt><dd>${val}</dd>`).join('')}</dl>` : '')
        + `<div class="acts"><button type="button" data-act="hide">${shown ? 'Hide this part' : 'Show this part'}</button>`
        + `<button type="button" data-act="only">Show only this</button><button type="button" data-act="all">Show all</button>`
        + (p ? `<button type="button" data-act="find">Find in table</button>` : '') + '</div><div class="msg" role="status"></div>';
      this.card.hidden = false;
    }

    say(text: string) {
      const m = this.card.querySelector('.msg');
      if (m) m.textContent = text;
    }

    act(what: string) {
      const v = this.viewer;
      const h = this.pinned;
      if (what === 'close' || !h) {
        this.unpin();
        return;
      }
      if (what === 'hide') {
        v.setState(h.node, this.visible(h.node) ? [0, 0] : [1, 1]);
      } else if (what === 'only') {
        v.treeview.hideAll();
        v.setState(h.node, [1, 1]);
      } else if (what === 'all') {
        v.treeview.showAll();
      } else if (what === 'find' && h.part) {
        const detail = { ids: [h.part.iid, h.part.id], found: false };
        document.dispatchEvent(new CustomEvent('ct:find-row', { detail }));
        this.showCard();
        this.say(detail.found ? 'Its row is selected in the table below' : 'No table on this page lists this part');
        return;
      }
      this.showCard();
    }

    // ---------------------------------------------------------------- Show in 3D, from a table
    leaves(node: string): string[] {
      return Object.keys(this.viewer.getStates()).filter((p) => p === node || p.startsWith(`${node}/`));
    }

    unmark() {
      const hl = this.viewer?.rendered?.nestedGroup?.highlight;
      for (const p of this.marked) hl?.selectSolid(p, false);
      this.marked = [];
      this.viewer?.update(true, false);
    }

    showParts(d: { ids: string[]; count: number }) {
      if (d.count || !this.viewer) return;
      const want = new Set(d.ids);
      const hits = Object.values(this.data.parts).filter((p) => want.has(p.iid) || want.has(p.id));
      if (!hits.length) return;
      d.count = hits.length;
      this.unmark();
      const hl = this.viewer.rendered.nestedGroup.highlight;
      for (const p of hits) {
        for (const node of p.paths) {
          if (!this.visible(node)) this.viewer.setState(node, [1, 1]);
          for (const leaf of this.leaves(node)) {
            hl.selectSolid(leaf, true);
            this.marked.push(leaf);
          }
        }
      }
      this.viewer.update(true, false);
      const first = hits[0];
      this.pin({ node: first.paths[0], label: this.data.nodes[first.paths[0]]?.[1] ?? first.name, part: first });
      if (hits.length > 1) this.say(`${hits.length} parts highlighted`);
      this.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }
  customElements.define('cad-viewer', CadViewerElement);
  // "Show in 3D" from a table goes to the first model on the page, in page order, that has one of the parts.
  document.addEventListener('ct:show-parts', (e) => {
    const d = (e as CustomEvent).detail as { ids: string[]; count: number };
    for (const el of Array.from(document.querySelectorAll('cad-viewer')) as CadViewerElement[]) {
      if (d.count) break;
      el.showParts(d);
    }
  });
</script>
